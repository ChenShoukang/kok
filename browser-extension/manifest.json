{
  "manifest_version": 3,
  "name": "Save to kok / 保存到 kok",
  "version": "0.9.0",
  "description": "Save selected text, readable pages and images into a paired local kok library.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Save to kok / 保存到 kok"},
  "options_page": "options.html"
}
